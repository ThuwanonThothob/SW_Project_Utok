{
  "name": "ThaiFlood Specialized Software Engineering Agent Team",
  "version": "2.0.0",
  "workflow": "dependency-driven-with-human-checkpoints",
  "agents": [
    {
      "id": "business-requirements",
      "name": "Business Requirements Agent",
      "phase": "discovery",
      "workstream": "Product discovery",
      "responsibilities": ["Identify stakeholders and user groups", "Define functional and non-functional requirements", "Record assumptions and scope boundaries"],
      "inputs": ["Project brief", "Instructor rubric"],
      "prompt": "prompts/business-requirements.md",
      "outputs": ["artifacts/stakeholder-requirements.md"],
      "dependsOn": [],
      "handoffTo": ["product-manager", "security-api-architect"]
    },
    {
      "id": "flood-domain-data",
      "name": "Flood Domain & Data Agent",
      "phase": "discovery",
      "workstream": "Flood-domain analysis",
      "responsibilities": ["Define flood-risk factors", "Catalogue hydrology and geospatial data", "Document safety and data-quality limitations"],
      "inputs": ["Project brief", "Thailand flood-risk context"],
      "prompt": "prompts/flood-domain-data.md",
      "outputs": ["artifacts/flood-domain-data.md"],
      "dependsOn": [],
      "handoffTo": ["product-manager", "gis-ui-design", "data-gis-architect", "risk-data-engineer"]
    },
    {
      "id": "product-manager",
      "name": "Product Manager Agent",
      "phase": "product",
      "workstream": "Product planning",
      "responsibilities": ["Prioritize MVP scope", "Write user stories and acceptance criteria", "Define delivery milestones"],
      "inputs": ["Stakeholder requirements", "Flood-domain rules"],
      "prompt": "prompts/product-manager.md",
      "outputs": ["artifacts/PRD.md", "artifacts/user-stories.md", "artifacts/presentation-guide.md"],
      "dependsOn": ["business-requirements", "flood-domain-data"],
      "handoffTo": ["ux-accessibility", "gis-ui-design", "solution-architect", "data-gis-architect", "security-api-architect"]
    },
    {
      "id": "ux-accessibility",
      "name": "UX & Accessibility Agent",
      "phase": "design",
      "workstream": "Citizen and authority experience",
      "responsibilities": ["Design user journeys", "Define responsive interaction states", "Specify WCAG-oriented accessibility requirements"],
      "inputs": ["PRD", "User stories"],
      "prompt": "prompts/ux-accessibility.md",
      "outputs": ["artifacts/ux-accessibility-spec.md"],
      "dependsOn": ["product-manager"],
      "handoffTo": ["solution-architect", "citizen-frontend", "authority-frontend", "qa-automation"]
    },
    {
      "id": "gis-ui-design",
      "name": "GIS & Map Experience Agent",
      "phase": "design",
      "workstream": "Geospatial visualization",
      "responsibilities": ["Define map layers and markers", "Specify flood-risk color semantics", "Design location and incident-reporting interactions"],
      "inputs": ["Flood-domain rules", "PRD"],
      "prompt": "prompts/gis-ui-design.md",
      "outputs": ["artifacts/gis-visual-spec.md"],
      "dependsOn": ["product-manager", "flood-domain-data"],
      "handoffTo": ["solution-architect", "data-gis-architect", "citizen-frontend"]
    },
    {
      "id": "solution-architect",
      "name": "Solution Architect Agent",
      "phase": "architecture",
      "workstream": "System architecture",
      "responsibilities": ["Define system boundaries and runtime topology", "Select technology and integration patterns", "Define component ownership"],
      "inputs": ["PRD", "UX specification", "GIS visual specification"],
      "prompt": "prompts/solution-architect.md",
      "outputs": ["artifacts/architecture.md"],
      "dependsOn": ["product-manager", "ux-accessibility", "gis-ui-design"],
      "handoffTo": ["citizen-frontend", "authority-frontend", "incident-realtime-backend", "risk-data-engineer", "devops-release"]
    },
    {
      "id": "data-gis-architect",
      "name": "Database & GIS Architect Agent",
      "phase": "architecture",
      "workstream": "Data architecture",
      "responsibilities": ["Model users, reports, broadcasts and risk zones", "Define PostGIS spatial types and indexes", "Plan migrations and data retention"],
      "inputs": ["Flood-domain rules", "PRD", "GIS visual specification"],
      "prompt": "prompts/data-gis-architect.md",
      "outputs": ["artifacts/data-gis-design.md", "../database/schema.sql"],
      "dependsOn": ["product-manager", "flood-domain-data", "gis-ui-design"],
      "handoffTo": ["identity-backend", "incident-realtime-backend", "risk-data-engineer"]
    },
    {
      "id": "security-api-architect",
      "name": "Security & API Contract Agent",
      "phase": "architecture",
      "workstream": "API and trust boundaries",
      "responsibilities": ["Define REST contracts", "Design JWT and role authorization", "Threat-model public reporting and authority actions"],
      "inputs": ["Stakeholder requirements", "PRD"],
      "prompt": "prompts/security-api-architect.md",
      "outputs": ["artifacts/api-spec.yaml", "artifacts/threat-model.md"],
      "dependsOn": ["business-requirements", "product-manager"],
      "handoffTo": ["citizen-frontend", "authority-frontend", "identity-backend", "incident-realtime-backend", "security-privacy-review"]
    },
    {
      "id": "citizen-frontend",
      "name": "Citizen Portal Frontend Agent",
      "phase": "implementation",
      "workstream": "Citizen web application",
      "responsibilities": ["Implement Citizen registration and login", "Build risk map and personal-risk experience", "Build crowdsourced incident reporting", "Implement installable Mobile PWA and Notification Test Lab"],
      "inputs": ["UX specification", "GIS visual specification", "API contract", "System architecture"],
      "prompt": "prompts/citizen-frontend.md",
      "outputs": ["../frontend/src/components/CitizenView.jsx", "../frontend/src/components/LoginModal.jsx", "../frontend/src/components/ReportDrawer.jsx", "../frontend/src/components/NotificationModal.jsx", "../frontend/src/components/InstallAppModal.jsx", "../frontend/public/manifest.webmanifest", "../frontend/public/sw.js"],
      "dependsOn": ["ux-accessibility", "gis-ui-design", "solution-architect", "security-api-architect"],
      "handoffTo": ["qa-automation", "accessibility-performance"]
    },
    {
      "id": "authority-frontend",
      "name": "Authority Dashboard Frontend Agent",
      "phase": "implementation",
      "workstream": "Authority operations console",
      "responsibilities": ["Implement authority metrics and moderation queue", "Build emergency broadcasting controls", "Build province risk management"],
      "inputs": ["UX specification", "API contract", "System architecture"],
      "prompt": "prompts/authority-frontend.md",
      "outputs": ["../frontend/src/components/AuthorityView.jsx", "../frontend/src/components/BroadcastModal.jsx"],
      "dependsOn": ["ux-accessibility", "solution-architect", "security-api-architect"],
      "handoffTo": ["qa-automation", "accessibility-performance"]
    },
    {
      "id": "identity-backend",
      "name": "Identity & Access Backend Agent",
      "phase": "implementation",
      "workstream": "Authentication and RBAC",
      "responsibilities": ["Implement Citizen registration and authentication", "Issue and verify JWTs", "Enforce Citizen and Authority permissions"],
      "inputs": ["API contract", "Threat model", "Data model"],
      "prompt": "prompts/identity-backend.md",
      "outputs": ["../backend/src/routes/auth.js", "../backend/src/middleware/auth.js", "../backend/test/auth.test.js"],
      "dependsOn": ["data-gis-architect", "security-api-architect"],
      "handoffTo": ["qa-automation", "security-privacy-review"]
    },
    {
      "id": "incident-realtime-backend",
      "name": "Incident, Broadcast & Realtime Agent",
      "phase": "implementation",
      "workstream": "Operational APIs and events",
      "responsibilities": ["Implement incident lifecycle APIs", "Implement emergency broadcasts", "Publish live Server-Sent Events"],
      "inputs": ["API contract", "Data model", "System architecture"],
      "prompt": "prompts/incident-realtime-backend.md",
      "outputs": ["../backend/src/routes/reports.js", "../backend/src/routes/broadcasts.js", "../backend/src/routes/events.js", "../backend/src/services/eventBus.js"],
      "dependsOn": ["solution-architect", "data-gis-architect", "security-api-architect"],
      "handoffTo": ["qa-automation", "security-privacy-review", "devops-release"]
    },
    {
      "id": "risk-data-engineer",
      "name": "Flood Risk & Data Engineering Agent",
      "phase": "implementation",
      "workstream": "Risk calculation and geospatial data",
      "responsibilities": ["Implement explainable flood-risk scoring", "Normalize province and incident data", "Support persistent runtime and PostgreSQL repositories", "Export 77-province dataset"],
      "inputs": ["Flood-domain rules", "Data model", "System architecture"],
      "prompt": "prompts/risk-data-engineer.md",
      "outputs": ["../backend/src/services/riskService.js", "../backend/src/data/repository.js", "../backend/src/routes/provinces.js", "../dataset/thailand_flood_risk_77_provinces.json", "../dataset/thailand_flood_risk_77_provinces.csv"],
      "dependsOn": ["flood-domain-data", "solution-architect", "data-gis-architect"],
      "handoffTo": ["qa-automation", "security-privacy-review"]
    },
    {
      "id": "flood-news-intelligence",
      "name": "Flood News & Situational Intelligence Agent",
      "phase": "implementation",
      "workstream": "Real-time Thailand flood news & AI incident triage",
      "responsibilities": ["Ingest and analyze real-time Thailand flood news", "Classify incident urgency with AI Triage (P1-P4)", "Generate automated rescue recommendations and push SSE news updates", "Sync live Open-Meteo weather, GloFAS river discharge, and user GPS telemetry"],
      "inputs": ["Flood-domain rules", "PRD", "System architecture"],
      "prompt": "prompts/flood-news-intelligence.md",
      "outputs": ["artifacts/flood-news-intelligence.md", "../backend/src/services/newsAgentService.js", "../backend/src/services/aiTriageService.js", "../backend/src/services/weatherService.js", "../backend/src/routes/intelligence.js", "../frontend/src/services/aiTriage.js", "../frontend/src/services/liveData.js"],
      "dependsOn": ["flood-domain-data", "product-manager", "solution-architect"],
      "handoffTo": ["qa-automation", "devops-release"]
    },
    {
      "id": "qa-automation",
      "name": "QA Automation Agent",
      "phase": "validation",
      "workstream": "Functional and integration quality",
      "responsibilities": ["Test acceptance criteria and role boundaries", "Verify production build and responsive flows", "Publish traceable test evidence"],
      "inputs": ["User stories", "Frontend implementations", "Backend implementations"],
      "prompt": "prompts/qa-automation.md",
      "outputs": ["artifacts/test-report.md", "../backend/test/riskService.test.js", "../backend/test/auth.test.js"],
      "dependsOn": ["citizen-frontend", "authority-frontend", "identity-backend", "incident-realtime-backend", "risk-data-engineer", "flood-news-intelligence"],
      "handoffTo": ["devops-release"]
    },
    {
      "id": "security-privacy-review",
      "name": "Security & Privacy Review Agent",
      "phase": "validation",
      "workstream": "Application security",
      "responsibilities": ["Review authentication and authorization controls", "Check privacy and upload risks", "Document residual risk and mitigations"],
      "inputs": ["Threat model", "Identity implementation", "Operational APIs"],
      "prompt": "prompts/security-privacy-review.md",
      "outputs": ["artifacts/security-review.md"],
      "dependsOn": ["security-api-architect", "identity-backend", "incident-realtime-backend", "risk-data-engineer"],
      "handoffTo": ["devops-release"]
    },
    {
      "id": "accessibility-performance",
      "name": "Accessibility & Performance Agent",
      "phase": "validation",
      "workstream": "Inclusive and responsive quality",
      "responsibilities": ["Check keyboard and semantic UI behavior", "Verify mobile responsiveness", "Review frontend bundle and map performance"],
      "inputs": ["Accessibility specification", "Citizen portal", "Authority dashboard"],
      "prompt": "prompts/accessibility-performance.md",
      "outputs": ["artifacts/accessibility-performance-report.md", "../scripts/performance-check.mjs"],
      "dependsOn": ["ux-accessibility", "citizen-frontend", "authority-frontend"],
      "handoffTo": ["devops-release"]
    },
    {
      "id": "devops-release",
      "name": "DevOps & Release Agent",
      "phase": "operations",
      "workstream": "Build, deployment and release",
      "responsibilities": ["Define local and container runbooks", "Verify environment and release gates", "Prepare rollback and operational readiness"],
      "inputs": ["Architecture", "Test report", "Security review", "Performance review"],
      "prompt": "prompts/devops-release.md",
      "outputs": ["artifacts/deployment-runbook.md", "artifacts/agent-operating-model.md", "../docker-compose.yml", "../README.md"],
      "dependsOn": ["solution-architect", "qa-automation", "security-privacy-review", "accessibility-performance"],
      "handoffTo": ["human-orchestrator"]
    }
  ],
  "checkpoints": [
    { "afterPhase": "product", "id": "requirements" },
    { "afterPhase": "design", "id": "experience" },
    { "afterPhase": "architecture", "id": "architecture" },
    { "afterPhase": "implementation", "id": "integration" },
    { "afterPhase": "operations", "id": "release" }
  ]
}
